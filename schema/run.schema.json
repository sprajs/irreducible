{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cosmology.run.v1",
  "oneOf": [
    {
      "$ref": "#/$defs/fixture"
    },
    {
      "$ref": "#/$defs/quantity"
    },
    {
      "$ref": "#/$defs/numerics"
    },
    {
      "$ref": "#/$defs/observations"
    },
    {
      "$ref": "#/$defs/gaussian"
    },
    {
      "$ref": "#/$defs/background"
    }
  ],
  "$defs": {
    "fixture": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "cosmology.fixture-run.v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "a",
        "b"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "const": "fixture.checked_i64_add.v1"
        },
        "a": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          }
        },
        "b": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          }
        },
        "fault": {
          "enum": [
            0,
            1,
            2
          ],
          "default": 0
        }
      },
      "description": "Strict bounded-integer infrastructure fixture. Arrays equal length; checked sum domain validated by C++. No arbitrary expressions. JSON field ordering irrelevant; arrays ordered. Fault injection is test-only and changes execution specification."
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "values",
        "source",
        "target"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "const": "quantity.convert.v1"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "source": {
          "$ref": "#/$defs/quantity_metadata"
        },
        "target": {
          "$ref": "#/$defs/quantity_metadata"
        }
      }
    },
    "quantity_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "role",
        "frame",
        "convention",
        "constant_set"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "one",
            "metre",
            "kilometre",
            "second",
            "day",
            "inverse_second",
            "parsec",
            "megaparsec",
            "km_per_s_per_mpc"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "ratio",
            "redshift",
            "physical_length",
            "comoving_distance",
            "luminosity_distance",
            "angular_diameter_distance",
            "duration",
            "expansion_rate"
          ]
        },
        "frame": {
          "type": "string",
          "enum": [
            "none",
            "heliocentric",
            "cmb",
            "model"
          ]
        },
        "convention": {
          "type": "string",
          "enum": [
            "none",
            "physical",
            "comoving_a0_one"
          ]
        },
        "constant_set": {
          "type": "string",
          "enum": [
            "SI-IAU-definitions-v1"
          ]
        }
      }
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "method",
        "values"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "const": "numerics.scalar_batch.v1"
        },
        "method": {
          "enum": [
            "compensated_sum",
            "log_sum_exp",
            "log1p",
            "expm1",
            "log_gamma_positive"
          ]
        },
        "values": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "table",
        "metadata",
        "selection",
        "resources"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "const": "observations.prepare.v1"
        },
        "table": {
          "type": "string"
        },
        "uncertainty": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/observation_metadata"
        },
        "selection": {
          "enum": [
            "all",
            "pantheon_zhd_gt_001"
          ]
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximum_asset_bytes",
            "maximum_rows",
            "maximum_matrix_elements",
            "maximum_string_bytes"
          ],
          "properties": {
            "maximum_asset_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 268435456
            },
            "maximum_rows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "maximum_matrix_elements": {
              "type": "integer",
              "minimum": 0,
              "maximum": 25000000
            },
            "maximum_string_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16777216
            }
          }
        },
        "source_selection": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        },
        "calibration_provenance": {
          "type": "string"
        },
        "dependence_provenance": {
          "type": "string"
        },
        "quality_dictionary": {
          "type": "string"
        },
        "ordering_provenance": {
          "type": "string"
        }
      }
    },
    "observation_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "role",
        "unit",
        "calibration",
        "uncertainty",
        "uncertainty_unit",
        "component"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "pantheon_plus_released_v1",
            "gaussian_fixture_v1",
            "fits_length_fixture_v1"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "observed_measurement",
            "released_fitted_summary",
            "synthetic_control",
            "posterior_summary"
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "magnitude",
            "metre"
          ]
        },
        "calibration": {
          "type": "string",
          "enum": [
            "unknown",
            "released_corrected",
            "not_applicable"
          ]
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "none",
            "covariance",
            "precision"
          ]
        },
        "uncertainty_unit": {
          "type": "string",
          "enum": [
            "none",
            "magnitude_squared",
            "inverse_magnitude_squared",
            "metre_squared",
            "inverse_metre_squared"
          ]
        },
        "component": {
          "type": "string",
          "enum": [
            "unknown",
            "statistical",
            "systematic",
            "total"
          ]
        }
      }
    },
    "gaussian": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "observations",
        "mode",
        "residual_unit",
        "response_unit",
        "ordered_ids",
        "residuals",
        "maximum_batch_elements",
        "maximum_forward_sensitivity"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "const": "statistics.gaussian_batch.v1"
        },
        "observations": {
          "$ref": "#/$defs/observations"
        },
        "mode": {
          "enum": [
            "normalized_density",
            "profile_offset_score"
          ]
        },
        "residual_unit": {
          "enum": [
            "magnitude",
            "metre"
          ]
        },
        "response_unit": {
          "const": "one"
        },
        "ordered_ids": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "string"
          }
        },
        "residuals": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "number"
            }
          }
        },
        "response": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          }
        },
        "proper_prior": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "response",
            "ordered_ids",
            "mean",
            "variance",
            "latent_identity",
            "independence_declared"
          ],
          "properties": {
            "response": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "ordered_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mean": {
              "type": "number"
            },
            "variance": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "latent_identity": {
              "type": "string",
              "minLength": 1
            },
            "independence_declared": {
              "type": "boolean"
            }
          }
        },
        "maximum_batch_elements": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maximum_forward_sensitivity": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "parameters",
        "queries",
        "policy"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "const": "background.parameter_query_batch.v1"
        },
        "parameters": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "h0_km_s_mpc",
              "omega_m",
              "constant_q"
            ],
            "properties": {
              "model": {
                "enum": [
                  "flat_lcdm_late_v1",
                  "constant_q_flat_v1"
                ]
              },
              "h0_km_s_mpc": {
                "type": "number"
              },
              "omega_m": {
                "type": "number"
              },
              "constant_q": {
                "type": "number"
              }
            }
          }
        },
        "queries": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "z_expansion",
              "z_observer",
              "convention"
            ],
            "properties": {
              "z_expansion": {
                "type": "number"
              },
              "z_observer": {
                "type": "number"
              },
              "convention": {
                "enum": [
                  "geometric_same_redshift",
                  "released_zhd_zhel"
                ]
              }
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximum_parameters",
            "maximum_queries",
            "maximum_slots",
            "maximum_native_output_bytes",
            "maximum_total_evaluations",
            "maximum_evaluations_per_integral",
            "maximum_depth",
            "absolute_tolerance",
            "relative_tolerance"
          ],
          "properties": {
            "maximum_parameters": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "maximum_queries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            },
            "maximum_slots": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "maximum_native_output_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 536870912
            },
            "maximum_total_evaluations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "maximum_evaluations_per_integral": {
              "type": "integer",
              "minimum": 3,
              "maximum": 18446744073709551615
            },
            "maximum_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "absolute_tolerance": {
              "type": "number",
              "minimum": 0
            },
            "relative_tolerance": {
              "type": "number",
              "minimum": 0
            }
          },
          "anyOf": [
            {
              "properties": {
                "absolute_tolerance": {
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "properties": {
                "relative_tolerance": {
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        }
      },
      "description": "Parameter-major Cartesian batch; CLI total JSON slots<=65536, native output storage and global integration callbacks bounded before allocation. Structural view only; C++ owns model domains/conventions."
    }
  },
  "description": "Structural generated view. C++ owns scientific admissibility, conversions and per-row statuses; successful execution without qualification remains unaccepted."
}
